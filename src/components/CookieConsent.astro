---
import 'vanilla-cookieconsent/dist/cookieconsent.css';
---

<div id="cc-container"></div>

<script>
  import * as CookieConsent from "vanilla-cookieconsent";

  /**
   * Helper to push to DataLayer (Google Analytics/GTM)
   */
  function updateGtmConsent(categories) {
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }

    // Map your categories to GTM consent types
    const isMarketing = categories.includes('marketing');
    const isAnalytics = categories.includes('analytics');

    gtag('consent', 'update', {
      'ad_user_data': isMarketing ? 'granted' : 'denied',
      'ad_personalization': isMarketing ? 'granted' : 'denied',
      'ad_storage': isMarketing ? 'granted' : 'denied',
      'analytics_storage': isAnalytics ? 'granted' : 'denied',
      'wait_for_update': 500
    });
    
    window.dataLayer.push({ 'gtm.start': new Date().getTime(), 'event': 'gtm.js' });
  }

  /**
   * Helper to send consent to your backend (Replaces $.post)
   */
  async function saveConsentToBackend(cookie) {
    // Replace with your actual backend URL
    const BASE_URL = 'https://kompasio.sk'; 
    const endpoint = `${BASE_URL}/app/sk/map/cookies/store-consent`;

    try {
      // We retrieve the ID from the internal state if it exists
      // Note: In v3, handling custom 'data' state is different, 
      // usually you just send the cookie object.
      await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          cookie: cookie,
          url: window.location.href
        })
      });
    } catch (error) {
      console.error("Failed to save consent:", error);
    }
  }

  // --- Initialize the Plugin ---
  CookieConsent.run({
    root: '#cc-container',
    
    // 1. Configure Categories (formerly "toggle" in blocks)
    categories: {
      necessary: {
        enabled: true,
        readOnly: true
      },
      analytics: {
        enabled: false,
        autoClear: {
          cookies: [
            { name: /^_ga/ }, // Regex match for _ga cookies
            { name: '_gid' }
          ]
        }
      }
    },

    // 2. Language & Text Configuration
    language: {
      default: 'sk',
      translations: {
        sk: {
          consentModal: {
            title: 'Používame cookies!',
            description: 'Na prevádzku tejto stránky používame cookies. Okrem cookies potrebných na prevádzku stránky používame aj cookies na analýzu používania stránky.',
            acceptAllBtn: 'Prijať všetky',
            acceptNecessaryBtn: 'Zamietnuť všetky',
            showPreferencesBtn: 'Nastaviť používanie cookies'
          },
          preferencesModal: {
            title: 'Nastavenie cookies',
            acceptAllBtn: 'Prijať všetky',
            acceptNecessaryBtn: 'Zamietnuť všetky',
            savePreferencesBtn: 'Uložiť nastavenia',
            closeIconLabel: 'Zatvoriť',
            sections: [
              {
                title: 'Použitie cookies',
                description: 'Cookies používame na zabezpečenie základnej funkčnosti našej stránky a taktiež na analýzu návštevnosti stránky. Môžete si vybrať, ktoré cookies môžeme používať a ktoré nie.'
              },
              {
                title: 'Potrebné cookies',
                description: 'Tieto cookies sú dôležité pre správne fungovanie stránky. Bez nich stránka nebude správne fungovať.',
                linkedCategory: 'necessary',
                cookieTable: {
                  headers: { name: 'Názov', domain: 'Doména', desc: 'Popis' },
                  body: [
                    { name: 'cc_cookie', domain: 'kompasio.sk', desc: 'Uloženie súhlasu s cookies' },
                    { name: 'PHPSESSID', domain: 'kompasio.sk', desc: 'Session ID pre správu relácie.' }
                  ]
                }
              },
              {
                title: 'Analytické cookies',
                description: 'Tieto cookies nám slúžia na sledovanie návštevnosti našej stránky.',
                linkedCategory: 'analytics',
                cookieTable: {
                  headers: { name: 'Názov', domain: 'Doména', desc: 'Popis' },
                  body: [
                    { name: '_ga', domain: '.kompasio.sk', desc: 'Google Analytics - štatistika.' },
                    { name: '_ga_*', domain: '.kompasio.sk', desc: 'Google Analytics - perzistencia.' }
                  ]
                }
              },
              {
                title: 'Viac informácií',
                description: 'Ak máte dotazy ohľadom cookies, môžete nás <a class="cc-link" href="https://kompasio.sk/app/sk/map/contact/">kontaktovať</a>.'
              }
            ]
          }
        }
      }
    },

    // 3. Callbacks (Logic)
    onFirstConsent: ({ cookie }) => {
      saveConsentToBackend(cookie);
    },

    onConsent: ({ cookie }) => {
      // Runs on first accept AND subsequent page loads if consent exists
      updateGtmConsent(cookie.categories);
    },

    onChange: ({ cookie, changedCategories }) => {
      saveConsentToBackend(cookie);
      updateGtmConsent(cookie.categories);
    }
  });
</script>
