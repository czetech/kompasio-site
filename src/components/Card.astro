---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Markdown from "~/components/Markdown.astro";

const { title, href, color, description } = Astro.props;

const external = /^https?:\/\//.test(href);

const Arrow = external ? ArrowUpRight : ArrowRight;

const colorMap = {"blue": ["bg-vibrant-blue", "text-shuttle-white"], "orange": ["bg-red-orange", "text-shuttle-white"], "white": ["text-vibrant-blue", "border"]};
---
<a href={href} target={external ? "_blank" : null}>
  <div class="rounded-2xl h-full min-h-32 w-64 p-4 flex flex-col gap-y-4" class:list={[colorMap[color]]}>
    <div class="flex gap-x-4 justify-between">
      <h1 class="text-2xl font-semibold line-clamp-3.">{title}</h1>
      <Arrow class="border rounded-full p-1 h-8 w-8 flex-none" />
    </div>
    <div class="text-sm">
      <Markdown content={description} />
    </div>
  </div>
</a>
