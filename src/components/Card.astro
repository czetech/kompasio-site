---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Markdown from "~/components/Markdown.astro";

const { title, href, color, image, description } = Astro.props;

const external = /^https?:\/\//.test(href);

const Arrow = external ? ArrowUpRight : ArrowRight;

const colorMap = {"blue": ["bg-vibrant-blue", "text-shuttle-white"], "orange": ["bg-red-orange", "text-shuttle-white"], "white": ["text-vibrant-blue", "border"]};
---
<a href={href} target={external ? "_blank" : null}>
  <div class="rounded-2xl p-6 grid gap-4 grid-cols-[1fr_auto]" class:list={[colorMap[color]]}>
    <h1 class="text-2xl font-semibold">{title}</h1>
    <Arrow class="border rounded-full p-1 w-8 h-8" />
    {image && <img src={image} class="rounded-lg col-span-2 mt-2" />}
    {description && <div class="text-sm col-span-2">
      <Markdown content={description} />
    </div>}
  </div>
</a>
