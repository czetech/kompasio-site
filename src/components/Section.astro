---
import CircleArrow from "~/components/CircleArrow.tsx";
const { heading } = Astro.props;
---

<section class="flex w-full max-w-7xl grow flex-col py-8">
  <div class="mb-4 flex items-center justify-center gap-x-4 md:mb-8">
    <CircleArrow direction="180" />
    <h1 class="text-2xl font-semibold md:text-3xl">{heading}</h1>
  </div>
  <div class="grow">
    <slot />
  </div>
</section>
