---
import { getEntry } from "astro:content";
import ContentImage from "~/components/ContentImage.astro";

const landing = await getEntry("landing", "landing");
---

<div class="mx-auto flex w-full max-w-212 flex-col gap-y-4 lg:relative">
  <div class="flex w-full justify-end">
    <ContentImage path={landing.data.heroImage} />
  </div>
  <div
    class={`flex h-full w-full justify-center lg:absolute lg:top-0 lg:w-96
      lg:flex-none lg:flex-col`}
  >
    <h1 class="text-vibrant-blue text-5xl font-semibold">
      {landing.data.heroTitle}
    </h1>
  </div>
</div>
