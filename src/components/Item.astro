---
import Markdown from "~/components/Markdown.astro";

const { heading, href, description, icon } = Astro.props;
---

<div class="flex flex-col gap-y-2 md:gap-y-3">
  <hr class="border-red-orange" />
  <a
    href={href}
    class={`text-vibrant-blue text-xl font-semibold hover:underline md:text-2xl
      flex gap-x-2 items-center`}
  >
    <slot name="icon" />
    <span>{heading}</span>
  </a>
  <Markdown content={description} />
</div>
