---
import Logo from "~/components/Logo.astro";
import Nav from "~/components/Nav.tsx";
import {navItemsPrimary } from "~/lib/navigation.ts";
import { getEntry } from "astro:content";

const global = await getEntry("global", "global");
---

<header
  id="header"
  transition:persist
  transition:name="header"
  class="text-vibrant-blue border-b-2 p-2 md:p-3"
>
<Nav client:load navItems={navItemsPrimary} pathname={Astro.url.pathname} searchPlaceholder={global.data.searchPlaceholder}>
    <Logo />
  </Nav>
</header>

<script>
  document.addEventListener("astro:before-swap", (e) => {
    const header = document.getElementById("header");
    if (header && e.from.pathname !== e.to.pathname) {
      header.dataset.previous = e.from.pathname;
    }
  });
</script>
