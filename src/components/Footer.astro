---
import { getEntry } from "astro:content";
import Logo from "~/components/Logo.astro";
import Plus from "lucide-solid/icons/plus";
import HeartHandshake from "lucide-solid/icons/heart-handshake";
import ArrowRight from "lucide-solid/icons/arrow-right";
import Button from "~/components/Button.tsx";
import Circle from "~/components/Circle.tsx";
import Facebook from '@lucide/astro/icons/facebook';
import Instagram from '@lucide/astro/icons/instagram';
import Youtube from '@lucide/astro/icons/youtube';
import Linkedin from '@lucide/astro/icons/linkedin';
import Earth from '@lucide/astro/icons/earth';

const footer = await getEntry("footer", "footer");

const navItems = [
  {
    title: "Miesta",
    href: "/miesta",
  },
  {
    title: "Návody",
    href: "/navody",
    test: "^\/(?:navody|zivotne-situacie)(?:\/.*)?$",
  },
  {
    title: "Kontakt",
    href: "/kontakt",
  },
  {
    title: "Chcem podporiť",
    href: "https://www.modrahliadka.sk/podpora/",
  },
];
---

<footer class={"bg-frontier-gray text-shuttle-white"}>
  <div class="flex justify-between p-4 sm:p-8 items-center flex-col gap-y-4 gap-x-8 sm:flex-row-reverse">
    <div class="flex flex-col gap-y-2 gap-x-4 lg:flex-row">
      <Button icon={Plus} text={footer.data.newPointText} href={footer.data.newPointUrl} class="bg-shuttle-white text-vibrant-blue" />
      <Button icon={ArrowRight} text={footer.data.howItWorksText} href={footer.data.howItWorksUrl} class="bg-shuttle-white text-vibrant-blue" />
      <Button icon={HeartHandshake} text={footer.data.supportUsText} href={footer.data.supportUsUrl} class="bg-shuttle-white text-vibrant-blue" />
    </div>
    <Logo class="h-10" />
  </div>
  <hr class="border-t-2" />
  
  <div>
    {navItems.map((navItem) => <a href={navItem.href}>{navItem.title}</a>)}
  </div>
  
  <a href="/vop">Podmienky používania</a>
  <a href="/gdpr">GDPR</a>

  {footer.data.facebookUrl && <Circle>
    <Facebook />
  </Circle>}
  {footer.data.instagramUrl && <Circle>
    <Instagram />
  </Circle>}
  {footer.data.youtubeUrl && <Circle>
    <Youtube />
  </Circle>}
  {footer.data.linkedinUrl && <Circle>
    <Linkedin />
  </Circle>}
  <Circle>
    <Earth />
  </Circle>

  <p>Copyright © 2025</p>
  <p>Modrá hliadka</p>
  
  <p>{footer.data.fundingHeadline}</p>
  <p>{footer.data.fundingText}</p>
</footer>
