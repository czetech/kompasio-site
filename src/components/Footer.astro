---
import { getEntry } from "astro:content";
import Logo from "~/components/Logo.astro";
import Plus from "lucide-solid/icons/plus";
import HeartHandshake from "lucide-solid/icons/heart-handshake";
import ArrowRight from "lucide-solid/icons/arrow-right";
import Github from "lucide-solid/icons/github";
import Button from "~/components/Button.tsx";
import Circle from "~/components/Circle.tsx";
import Facebook from "lucide-solid/icons/facebook";
import Instagram from "lucide-solid/icons/instagram";
import Youtube from "lucide-solid/icons/youtube";
import Linkedin from "lucide-solid/icons/linkedin";
import Earth from "lucide-solid/icons/earth";
import ContentImage from "~/components/ContentImage.astro";
import {navItemsPrimary, navItemsSecondary } from "~/lib/navigation.ts";

const { navItems } = Astro.props;

const footer = await getEntry("footer", "footer");

const buttons = [
  {
    icon: Plus,
    text: footer.data.newPointText,
    href: footer.data.newPointUrl,
  },
  {
    icon: ArrowRight,
    text: footer.data.howItWorksText,
    href: footer.data.howItWorksUrl,
  },
  {
    icon: HeartHandshake,
    text: footer.data.supportUsText,
    href: footer.data.supportUsUrl,
  },
];

const socialIcons = [
  {
    icon: Facebook,
    url: footer.data.facebookUrl,
    text: "Facebook",
  },
  {
    icon: Instagram,
    url: footer.data.instagramUrl,
    text: "Instagram",
  },
  {
    icon: Youtube,
    url: footer.data.youtubeUrl,
    text: "YouTube",
  },
  {
    icon: Linkedin,
    url: footer.data.linkedinUrl,
    text: "LinkedIn",
  },
  {
    icon: Github,
    url: footer.data.githubUrl,
    text: "GitHub",
  },
  {
    icon: Earth,
    url: footer.data.mhUrl,
    text: "Modrá Hliadka",
  },
];

const currentYear = new Date().getFullYear();
---

<footer transition:persist class="bg-frontier-gray text-shuttle-white">
  <div
    class={`flex flex-col items-center justify-between gap-x-8 gap-y-4 p-4
      sm:flex-row-reverse sm:p-8`}
  >
    <div class="flex flex-col gap-x-4 gap-y-2 lg:flex-row">
      {
        buttons.map((button) => (
          <Button
            icon={button.icon}
            text={button.text}
            href={button.href}
            class="bg-shuttle-white text-vibrant-blue"
          />
        ))
      }
    </div>
    <Logo class="h-10" />
  </div>
  <hr class="border-t-2" />
  <div class="grid grid-cols-1 gap-x-16 gap-y-8 p-4 sm:p-8 lg:grid-cols-2">
    <div class="flex flex-col gap-y-4 sm:gap-y-8 sm:mb-4">
      <div class="flex justify-center gap-x-2 lg:justify-start">
        {
          socialIcons.map(
            (socialIcon) =>
              socialIcon.url && (
                <a
                  href={socialIcon.url}
                  target="_blank"
                  class="p-1"
                  aria-label={socialIcon.text}
                >
                  <Circle>
                    <socialIcon.icon />
                  </Circle>
                </a>
              ),
          )
        }
      </div>
      <div class="grid sm:grid-cols-2 gap-y-2 text-sm lg:text-base [&>div]:flex [&>div]:flex-col [&>div]:items-center [&>div]:gap-y-2 lg:[&>div]:items-start">
        <div>
          {
            navItemsPrimary.map((navItem) => (
              <a
                href={navItem.href}
                target={navItem.target}
                class="hover:underline"
              >
                {navItem.title}
              </a>
            ))
          }
        </div>
        <div>
          {
            navItemsSecondary.map((secondaryNavItem) => (
              <a href={secondaryNavItem.url} class="hover:underline">
                {secondaryNavItem.title}
              </a>
            ))
          }
          <button type="button" class="hover:underline" data-cc="c-settings">Nastavenia cookies</button>
        </div>
      </div>
    </div>
    <div
      class={`flex flex-wrap items-center justify-center gap-x-8 gap-y-4
        lg:col-span-2`}
    >
      {
        footer.data.partners.map((partner) => (
          <ContentImage
            path={partner.image}
            alt={partner.name}
            class="h-18 max-w-32 object-contain lg:h-18 lg:max-w-48"
            style="filter: brightness(0) invert(1);"
          />
        ))
      }
    </div>
    <div class="flex flex-col gap-y-2 text-xs lg:text-sm lg:col-start-2 lg:row-start-1">
      <p>{footer.data.fundingHeadline}</p>
      <p class="text-justify">{footer.data.fundingText}</p>
    </div>
    <div class="flex justify-center gap-x-2 text-sm lg:col-span-2">
      <p>Copyright © {currentYear}</p>
      <span>🤍</span>
      <a href="https://modrahliadka.sk/" target="_blank" class="hover:underline"
        >Modrá Hliadka</a
      >
    </div>
  </div>
</footer>
