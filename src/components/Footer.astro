---
import { getEntry } from "astro:content";
import Logo from "~/components/Logo.astro";
import Plus from "lucide-solid/icons/plus";
import HeartHandshake from "lucide-solid/icons/heart-handshake";
import ArrowRight from "lucide-solid/icons/arrow-right";
import Button from "~/components/Button.tsx";
import Circle from "~/components/Circle.tsx";
import Facebook from "lucide-solid/icons/facebook";
import Instagram from "lucide-solid/icons/instagram";
import Youtube from "lucide-solid/icons/youtube";
import Linkedin from "lucide-solid/icons/linkedin";
import Earth from "lucide-solid/icons/earth";
import ContentImage from "~/components/ContentImage.astro";

const footer = await getEntry("footer", "footer");

const navItems = [
  {
    title: "Miesta",
    href: "/miesta",
  },
  {
    title: "Návody",
    href: "/navody",
    test: "^\/(?:navody|zivotne-situacie)(?:\/.*)?$",
  },
  {
    title: "Kontakt",
    href: "/kontakt",
  },
  {
    title: "Chcem podporiť",
    href: "https://www.modrahliadka.sk/podpora/",
  },
];
---

<footer class="bg-frontier-gray text-shuttle-white">
  <div
    class="flex flex-col items-center justify-between gap-x-8 gap-y-4 p-4
      sm:flex-row-reverse sm:p-8"
  >
    <div class="flex flex-col gap-x-4 gap-y-2 lg:flex-row">
      <Button
        icon={Plus}
        text={footer.data.newPointText}
        href={footer.data.newPointUrl}
        class="bg-shuttle-white text-vibrant-blue"
      />
      <Button
        icon={ArrowRight}
        text={footer.data.howItWorksText}
        href={footer.data.howItWorksUrl}
        class="bg-shuttle-white text-vibrant-blue"
      />
      <Button
        icon={HeartHandshake}
        text={footer.data.supportUsText}
        href={footer.data.supportUsUrl}
        class="bg-shuttle-white text-vibrant-blue"
      />
    </div>
    <Logo class="h-10" />
  </div>
  <hr class="border-t-2" />
  <div class="p-4 sm:p-8 flex-col gap-y-8">
    <div class="grid grid-cols-1 gap-y-2 gap-x-8 sm:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-y-2 items-start">
        {navItems.map((navItem) => (
          <a href={navItem.href} class="text-sm hover:underline">{navItem.title}</a>
        ))}
      </div>
      <div class="flex flex-col gap-y-4">
        <div class="flex flex-col gap-y-2 items-start">
          <a href="/vop" class="text-sm hover:underline">Podmienky používania</a>
          <a href="/gdpr" class="text-sm hover:underline">GDPR</a>
        </div>
        <div class="flex flex-row items-center gap-x-2 justify-center sm:justify-start">
          {footer.data.facebookUrl && (
            <a href={footer.data.facebookUrl} aria-label="Facebook">
              <Circle>
                <Facebook />
              </Circle>
            </a>
          )}
          {footer.data.instagramUrl && (
            <a href={footer.data.instagramUrl} aria-label="Instagram">
              <Circle>
                <Instagram />
              </Circle>
            </a>
          )}
          {footer.data.youtubeUrl && (
            <a href={footer.data.youtubeUrl} aria-label="Youtube">
              <Circle>
                <Youtube />
              </Circle>
            </a>
          )}
          {footer.data.linkedinUrl && (
            <a href={footer.data.linkedinUrl} aria-label="LinkedIn">
              <Circle>
                <Linkedin />
              </Circle>
            </a>
          )}
          <a href="https://modrahliadka.sk/" aria-label="Website">
            <Circle><Earth /></Circle>
          </a>
        </div>
      </div>
      <div class="text-xs sm:col-span-2 flex flex-col gap-y-2 mt-6 lg:mt-0">
        <p>{footer.data.fundingHeadline}</p>
        <p>{footer.data.fundingText}</p>
      </div>
    </div>
    <div class="flex flex-col items-center justify-between gap-8 pt-8 lg:flex-row-reverse">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
        {footer.data.partners.map((partner) => (
          <ContentImage
            path={partner.image}
            alt={partner.name}
            class="object-contain h-18 lg:h-18 max-w-32 lg:max-w-48"
            style="filter: brightness(0) invert(1);"
          />
        ))}
      </div>
      <div class="text-center text-sm md:text-left flex flex-col gap-y-2">
        <p>Copyright © 2024</p>
        <a href="https://modrahliadka.sk/" class="hover:underline">Modrá Hliadka</a>
      </div>
    </div>
  </div>
</footer>
