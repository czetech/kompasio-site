---
import { getEntry } from "astro:content";
import Card from "~/components/Card.astro";
import Markdown from "~/components/Markdown.astro";
import ContentImage from "~/components/ContentImage.astro";

const landing = await getEntry("landing", "landing");
---

<div class="flex w-full justify-center p-8">
  <div
    class={`masonry-launchpad relative w-full max-w-(--masonry-2col-width)
      opacity-0 xl:max-w-(--masonry-3col-width)
      2xl:max-w-(--masonry-4col-width)`}
  >
    {
      landing.data.cards.map((card) => (
        <Card
          title={card.title}
          color={card.color}
          href={card.url}
          class="absolute"
        >
          {card.image && (
            <div class="flex justify-center">
              <ContentImage path={card.image} class="mb-3 rounded-lg" />
            </div>
          )}
          {card.description && (
            <div class="text-sm">
              <Markdown content={card.description} />
            </div>
          )}
        </Card>
      ))
    }
  </div>
</div>

<script>
  import MiniMasonry from "minimasonry";

  const cardWidth = 320;
  const gap = 32;
  const widthPx = (columns) => `${cardWidth * columns + gap * (columns - 1)}px`;

  const initMasonry = () => {
    const masonryElement = document.querySelector(".masonry-launchpad");

    if (!masonryElement) {
      return;
    }

    masonryElement.style.setProperty("--masonry-2col-width", widthPx(2));
    masonryElement.style.setProperty("--masonry-3col-width", widthPx(3));
    masonryElement.style.setProperty("--masonry-4col-width", widthPx(4));
    new MiniMasonry({
      baseWidth: cardWidth,
      container: masonryElement,
      gutter: gap,
      surroundingGutter: false,
      ultimateGutter: gap,
    });
    masonryElement.classList.remove("opacity-0");
  };

  initMasonry();

  document.addEventListener("astro:after-swap", initMasonry);
</script>
