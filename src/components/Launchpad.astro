---
import { getEntry } from "astro:content";
import Card from "~/components/Card.astro";
import Markdown from "~/components/Markdown.astro";
import ContentImage from "~/components/ContentImage.astro";

const landing = await getEntry("landing", "landing");
---
<div class="p-8 flex justify-center w-full">
  <div class="masonry-launchpad relative w-full max-w-(--masonry-3col-width) xl:max-w-(--masonry-4col-width) 2xl:max-w-(--masonry-5col-width) opacity-0">
    {
      landing.data.cards.map((card) => (
        <Card title={card.title} color={card.color} href={card.url} class="absolute">
          {card.image && <div class="flex justify-center">
            <ContentImage path={card.image} class="rounded-lg col-span-2 mb-3" />
          </div>}
          {card.description && <div class="text-sm col-span-2">
            <Markdown content={card.description} />
          </div>}
        </Card>
      ))
    }
  </div>
</div>

<script>
  import MiniMasonry from "minimasonry";

  const cardWidth = 256;
  const gap = 32;
  const widthPx = (columns) => `${cardWidth * columns + gap * (columns - 1)}px`;

  const initMasonry = () => {
    const masonryElement = document.querySelector('.masonry-launchpad');

    if (!masonryElement) {
      return;
    }

    masonryElement.style.setProperty('--masonry-3col-width', widthPx(3));
    masonryElement.style.setProperty('--masonry-4col-width', widthPx(4));
    masonryElement.style.setProperty('--masonry-5col-width', widthPx(5));
    new MiniMasonry({
      baseWidth: cardWidth,
      container: masonryElement,
      gutter: gap,
      surroundingGutter: false,
      ultimateGutter: gap,
    });
    masonryElement.classList.remove("opacity-0");
  };

  initMasonry();

  document.addEventListener("astro:after-swap", initMasonry);
</script>
