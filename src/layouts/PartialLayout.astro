---
import { fontCss, shadowCss } from "~/lib/shadow-css.ts";

export const partial = true;
---
<style set:html={fontCss}></style>
<div>
  <template shadowrootmode="open">
    <div>
      <template shadowrootmode="open">
        <style set:html={shadowCss}></style>
        <slot />
      </template>
    </div>
  </template>
</div>
