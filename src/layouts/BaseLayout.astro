---
import { pwaInfo } from 'virtual:pwa-info';
import { ClientRouter } from "astro:transitions";
import "@fontsource/poppins/400.css";
import "@fontsource/poppins/500.css";
import "@fontsource/poppins/600.css";
import Logo from "~/components/Logo.astro";
import Nav from "~/components/Nav.tsx";
import "~/styles/global.css";
import Footer from "~/components/Footer.astro";

const { strictHeight = false } = Astro.props;

const navItems = [
  {
    title: "Zoznam",
    href: "/zoznam/",
  },
  {
    title: "Miesta",
    href: "/miesta",
  },
  {
    title: "Návody",
    href: "/navody",
    test: "^\/(?:navody|zivotne-situacie)(?:\/.*)?$",
  },
  {
    title: "Kontakt",
    href: "/kontakt",
  },
  {
    title: "Chcem podporiť",
    href: "https://www.modrahliadka.sk/podpora/",
    target: "_blank",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="author" content="Modrá hliadka" />
    <meta name="application-name" content="Kompasio" />
    <meta
      name="description"
      content="Kompasio je portál pre autistov resp. osoby s poruchou autistického spektra (PAS)."
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="keywords" content="autizmus, pas" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.json" />
    <title>Kompasio</title>
    <ClientRouter />
    { pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} /> }
  </head>
  <body class="text-space-blue bg-shuttle-white">
    <div
      class="flex min-h-dvh flex-col"
      class:list={{ "min-h-dvh": !strictHeight, "h-dvh": strictHeight }}
    >
      <header transition:persist class="text-vibrant-blue border-b-2">
        <Nav client:load navItems={navItems} pathname={Astro.url.pathname}>
          <Logo />
        </Nav>
      </header>
      <main class="flex grow flex-col items-center">
        <slot />
      </main>
    </div>
    <Footer navItems={navItems} />
  </body>
</html>
