---
import { getEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Markdown from "~/components/Markdown.astro";
import Section from "~/components/Section.astro";

const donate = await getEntry("donate", "donate");
---

<BaseLayout>
  <Section heading={donate.data.title}>
    <div
      class={`grid max-w-7xl gap-x-32 gap-y-8 px-8 pt-4 md:gap-y-16
        lg:grid-cols-2`}
    >
      <Markdown content={donate.data.body} />
      <stripe-buy-button
        class="self-start justify-self-center"
        buy-button-id={donate.data.stripePayButtonId}
        publishable-key={donate.data.stripePublishableKey}
      >
      </stripe-buy-button>
    </div>
  </Section>
</BaseLayout>

<script async src="https://js.stripe.com/v3/buy-button.js"></script>
