---
import { getEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Mail from "@lucide/astro/icons/mail";
import CircleArrow from "~/components/CircleArrow.tsx";
import Card from "~/components/Card.astro";
import Button from "~/components/Button.tsx";

const contact = await getEntry("contact", "contact");
---

<BaseLayout>
  <div class="flex items-center justify-center gap-x-4 p-8">
    <CircleArrow direction="180" />
    <h1 class="text-2xl font-semibold md:text-3xl">{contact.data.title}</h1>
  </div>
  <div class="flex w-full grow flex-col items-center justify-center p-8">
    <Card title={contact.data.cardTitle} color="blue" class="w-full max-w-120">
      <p class="mt-16 mb-3">{contact.data.emailLabel}</p>
      <Button
        href={`mailto:${contact.data.emailAddress}`}
        text={contact.data.emailAddress}
      >
        <Mail slot="icon" />
      </Button>
    </Card>
  </div>
</BaseLayout>
