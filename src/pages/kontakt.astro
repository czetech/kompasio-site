---
import { getEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Mail from "lucide-solid/icons/mail";
import Card from "~/components/Card.astro";
import Button from "~/components/Button.tsx";
import Markdown from "~/components/Markdown.astro";
import Section from "~/components/Section.astro";

const contact = await getEntry("contact", "contact");
---

<BaseLayout>
  <Section heading={contact.data.title}>
    <div
      class={`grid max-w-7xl gap-x-32 gap-y-8 px-8 pt-4 md:gap-y-16
        lg:grid-cols-2`}
    >
      <Markdown content={contact.data.body} />
      <Card
        title={contact.data.cardTitle}
        color="blue"
        class="w-full max-w-120 self-start justify-self-center"
      >
        <p class="mt-16 mb-3">{contact.data.emailLabel}</p>
        <Button
          href={`mailto:${contact.data.emailAddress}`}
          text={contact.data.emailAddress}
          icon={Mail}
          compact
        />
      </Card>
    </div>
  </Section>
</BaseLayout>
