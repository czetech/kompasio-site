---
import { getEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ArrowDown from "@lucide/astro/icons/arrow-down";
import Mail from "@lucide/astro/icons/mail";

const contact = await getEntry("contact", "contact");
---

<BaseLayout>
  <div class="flex gap-x-4 items-center p-8 justify-center">
    <ArrowDown class="p-1 border rounded-full w-8 h-8" />
    <h1 class="font-semibold text-2xl md:text-3xl">{contact.data.title}</h1>
  </div>
  <div class="grow p-8 flex justify-center flex-col items-center">
    <div class="bg-vibrant-blue p-8 max-w-144 w-full rounded-2xl flex flex-col gap-y-16 text-shuttle-white">
      <h2 class="text-xl md:text-2xl font-semibold">Kontaktujte nás</h2>
      <div class="flex flex-col gap-y-2">
        <p>Napíšte nám</p>
        <a class="border rounded-full flex self-start items-center gap-x-4 pr-4">
          <Mail class="p-1.5 w-8 h-8 border rounded-full" />
          <span>kompas@modrahliadka.sk</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
