---
import { getEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import ArrowDown from "@lucide/astro/icons/arrow-down";
import Mail from "@lucide/astro/icons/mail";
import Circle from "~/components/Circle.tsx"
import CircleArrow from "~/components/CircleArrow.tsx"
import Card from "~/components/Card.astro";

const contact = await getEntry("contact", "contact");
---

<BaseLayout>
  <div class="flex gap-x-4 items-center p-8 justify-center">
    <CircleArrow direction="180" />
    <h1 class="font-semibold text-2xl md:text-3xl">{contact.data.title}</h1>
  </div>
  <div class="grow p-8 flex justify-center flex-col items-center w-full">
    <Card title={contact.data.cardTitle} color="blue" class="max-w-128 w-full">
      <p class="mb-4 mt-16">{contact.data.emailLabel}</p>
      <a href={`mailto:${contact.data.emailAddress}`} class="border-y-2 border-r-2 rounded-full flex self-start items-center gap-x-4 pr-4">
        <Circle>
          <Mail />
        </Circle>
        <span>{contact.data.emailAddress}</span>
      </a>
    </Card>
  </div>
</BaseLayout>
