---
import { getEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Mail from "@lucide/astro/icons/mail";
import CircleArrow from "~/components/CircleArrow.tsx"
import Card from "~/components/Card.astro";
import Button from "~/components/Button.tsx";

const contact = await getEntry("contact", "contact");
---

<BaseLayout>
  <div class="flex gap-x-4 items-center p-8 justify-center">
    <CircleArrow direction="180" />
    <h1 class="font-semibold text-2xl md:text-3xl">{contact.data.title}</h1>
  </div>
  <div class="grow p-8 flex justify-center flex-col items-center w-full">
    <Card title={contact.data.cardTitle} color="blue" class="max-w-120 w-full">
      <p class="mb-3 mt-16">{contact.data.emailLabel}</p>
      <Button href={`mailto:${contact.data.emailAddress}`} text={contact.data.emailAddress}>
        <Mail slot="icon" />
      </Button>
    </Card>
  </div>
</BaseLayout>
