---
import { getCollection, getEntry } from "astro:content";
import path from "pathe";

import Section from "~/components/Section.astro";
import Item from "~/components/Item.astro";
import List from "~/components/List.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";

const categories = await getCollection("guidesCategories");

const guides = await getEntry("guides", "guides");

const featuredJourneys = await getCollection("guidesJourneys", ({ data }) =>
  guides.data.featured.includes(data.uuid),
);
---

<BaseLayout>
  <Section heading="Kategórie">
    <List columns={true}>
      {
        categories.map((category) => (
          <Item
            heading={category.data.title}
            href={path.join("/navody", category.id)}
            description={category.data.description}
          />
        ))
      }
    </List>
  </Section>
  <Section heading="Vybrané návody">
    <List>
      {
        featuredJourneys.map((journey) => (
          <Item
            heading={journey.data.title}
            href={path.join("/zivotne-situacie", journey.id)}
            description={journey.data.description}
          />
        ))
      }
    </List>
  </Section>
</BaseLayout>
