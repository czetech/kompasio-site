---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Places from "~/components/Places.tsx";
import CircleArrow from "~/components/CircleArrow.tsx";
---

<BaseLayout>
  <div class="flex items-center justify-center gap-x-4 p-8">
    <CircleArrow direction="180" />
    <h1 class="text-2xl font-semibold md:text-3xl">Miesta</h1>
  </div>
  <div class="mx-auto max-w-[1000px] p-8">
    <Places client:only />
  </div>
</BaseLayout>
