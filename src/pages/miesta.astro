---
import BaseLayout from "~/layouts/BaseLayout.astro";
import ArrowDown from "@lucide/astro/icons/arrow-down";
import Places from "~/components/Places.tsx"
---

<BaseLayout>
  <div class="flex gap-x-4 items-center p-8 justify-center">
    <ArrowDown class="p-1 border rounded-full w-8 h-8" />
    <h1 class="font-semibold text-2xl md:text-3xl">Miesta</h1>
  </div>
  <div class="p-8 max-w-[1000px] mx-auto">
    <Places client:only />
  </div>
</BaseLayout>
