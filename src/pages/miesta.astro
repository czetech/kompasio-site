---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Places from "~/components/Places.tsx";
import { getCollection } from "astro:content";

const placesParameters = await getCollection("placesParameters");
const placesParametersOptions = await getCollection("placesParametersOptions");

const parameters = placesParameters.reduce((acc, placeParameter) => {
    acc[parseInt(placeParameter.id)] = placeParameter.data;
    return acc;
  }, {});

const options = placesParametersOptions.reduce((acc, placeParameterOption) => {
    acc[parseInt(placeParameterOption.id)] = placeParameterOption.data;
    return acc;
  }, {});
---
<BaseLayout>
  <div class="max-w-[1800px] w-full p-8">
    <Places client:only parameters={parameters} options={options} />
  </div>
</BaseLayout>
