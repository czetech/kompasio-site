---
export const prerender = false;

import BaseLayout from "~/layouts/BaseLayout.astro";

const AUTH_USER = "kompas";
const AUTH_PASS = "kompas";

const fetchOptions = {
  headers: {
    Accept: "application/json",
    Authorization: `Basic ${Buffer.from(`${AUTH_USER}:${AUTH_PASS}`).toString("base64")}`,
  },
};

let content;
let error;

try {
  const response = await fetch(`https://kompas.cassiopea.sk${Astro.url.pathname}${Astro.url.search}`, fetchOptions);
  if (!response.ok) {
    throw new Error(`Failed to fetch: ${response.status} ${response.statusText}`);
  }
  content = (await response.json()).content;
} catch (e) {
  error = e.message;
}

---

<BaseLayout>
  <div id="legacy-content-host" class="w-full">
    <template shadowrootmode="open">
      { content && <Fragment set:html={content} /> }
      { error && <h1>Error 500</h1><pre>{error}</pre> }
    </template>
  </div>
</BaseLayout>

<script>
  requestAnimationFrame(() => {
    const host = document.getElementById('legacy-content-host');
    if (host && host.shadowRoot) {
      const dsdGuestAppReadyEvent = new CustomEvent('guest-app:ready', {
        bubbles: true,
        composed: true,
        detail: {
          message: 'DSD Guest App content is ready.'
        }
      });

      host.dispatchEvent(dsdGuestAppReadyEvent);
    }
  });
</script>
