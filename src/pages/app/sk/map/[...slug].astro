---
export const prerender = false;

import BaseLayout from "~/layouts/BaseLayout.astro";

const AUTH_USER = "kompas";
const AUTH_PASS = "kompas";

const body = Astro.request.body ? await Astro.request.text() : undefined;

console.log(`Astro: ${body}`);

//const testResponse = await fetch("https://kompas.cassiopea.sk/app/sk/map/zoznam", {
//  "headers": {
//    "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
//    "content-type": "application/x-www-form-urlencoded",
//    "cookie": "PHPSESSID=1klfiiu1j0l56jjr6nh5ncvncr; _nss=1",
//  },
//  "body": "category=zakladna-skola&location=&search=H%C4%BEada%C5%A5&clearParameters=1&_do=filterForm-submit",
//  "method": "POST",
// redirect: "manual",
//});

//console.log(`Test response: ${testResponse.status} ${testResponse.statusText} ${testResponse.headers.get('location')}`);

const fetchOptions = {
  method: Astro.request.method,
  body: body,
  headers: {
    Accept: "application/json",
    "Content-Type": Astro.request.body ? "application/x-www-form-urlencoded" : undefined,
    Authorization: `Basic ${Buffer.from(`${AUTH_USER}:${AUTH_PASS}`).toString("base64")}`,
  },
  redirect: "manual",
};

let content;
let error;

try {
  console.log(`Request: ${JSON.stringify(fetchOptions)}`);
  const response = await fetch(`https://kompas.cassiopea.sk${Astro.url.pathname}${Astro.url.search}`, fetchOptions);
  console.log(`Response: ${response.ok} ${response.status} ${response.statusText} ${response.type}`);
  //if (!response.ok) {
  //  console.log("Throwing error?");
  //  throw new Error(`Failed to fetch: ${response.status} ${response.statusText}`);
  //}
  console.log(response.status);
  if (response.status >= 300 && response.status < 400) {
    console.log(response.status);
    console.log(`Redirect to: ${response.status} ${response.headers.get('location')}`);
    return Astro.redirect(response.headers.get('location'), response.status);
  }
  console.log(response.status);
  content = (await response.json()).content;
  
} catch (e) {
  error = e.message;
}

---

<BaseLayout>
  <div id="legacy-content-host" class="w-full">
    <template shadowrootmode="open">
      { content && <Fragment set:html={content} /> }
      { error && <h1>Error 500</h1><pre>{error}</pre> }
    </template>
  </div>
</BaseLayout>

<script>
  import { navigate, supportsViewTransitions } from "astro:transitions/client";

  function initializeDSD() {
    console.log("Astro debug: page-load");

    document.querySelectorAll('template[shadowrootmode]').forEach(template => {
      if (template.parentElement && !template.parentElement.shadowRoot) {
        const mode = template.getAttribute('shadowrootmode');
        const shadowRoot = template.parentElement.attachShadow({ mode });
        shadowRoot.appendChild(template.content.cloneNode(true));
        template.remove();
      }
    });

    const host = document.getElementById('legacy-content-host');
    if (host && host.shadowRoot) {
      const dsdGuestAppReadyEvent = new CustomEvent('guest-app:ready', {
        bubbles: true,
        composed: true,
        detail: {
          message: 'DSD Guest App content is ready.'
        }
      });
      console.log('guest-app:ready event dispatched.'); // For debugging
      host.dispatchEvent(dsdGuestAppReadyEvent);
    }
  }

  function deleteGuest() {
    console.log("Astro debug: before-swap");

    const host = document.getElementById('legacy-content-host');
    if (host && host.shadowRoot) {
      const dsdGuestAppDestroyEvent = new CustomEvent('guest-app:destroy', {
        bubbles: true,
        composed: true,
        detail: {
          message: 'DSD Guest App content should be destroyed.'
        }
      });
      host.dispatchEvent(dsdGuestAppDestroyEvent);
      console.log('guest-app:destroy event dispatched.'); // For debugging
    }
  }

  document.addEventListener('astro:before-swap', deleteGuest);
  document.addEventListener('astro:page-load', initializeDSD);

  const isSamePage = (e) => {
    const fromUrl = new URL(e.from);
    const toUrl = new URL(e.to);
    fromUrl.hash = "";
    toUrl.hash = "";
    return fromUrl.href === toUrl.href;
  };

  const handleAstroBeforePreparation = (e) => {
    if (isSamePage(e)) e.loader = async () => {};
  };

  const handleAstroBeforeSwap = (e) => {
    if (isSamePage(e)) {
      e.swap = () => {};
      e.viewTransition.skipTransition();
    }
  };

  //document.addEventListener('astro:before-preparation', handleAstroBeforePreparation);
  //document.addEventListener('astro:before-swap', handleAstroBeforeSwap);

  function guestSetHash(hash) {
    const url = new URL(window.location);
    url.hash = hash;
    if (supportsViewTransitions) {
      navigate(url, { history: "replace" });
    }
    else {
      history.replaceState(null, '', url.href);
    }
    console.log("guestSetHash", hash);
  }

  window.guest = window.guest || {};
  window.guest.setHash = guestSetHash;
</script>
