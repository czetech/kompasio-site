---
export const prerender = false;

import BaseLayout from "~/layouts/BaseLayout.astro";

const AUTH_USER = "kompas";
const AUTH_PASS = "kompas";

const fetchOptions = {
  headers: {
    Accept: "application/json",
    Authorization: `Basic ${Buffer.from(`${AUTH_USER}:${AUTH_PASS}`).toString("base64")}`,
  },
};

let content;
let error;

try {
  const response = await fetch(`https://kompas.cassiopea.sk${Astro.url.pathname}`, fetchOptions);
  if (!response.ok) {
    throw new Error(`Failed to fetch: ${response.status} ${response.statusText}`);
  }
  content = (await response.json()).content;
} catch (e) {
  console.log(e.message)
  Astro.response.status = 500;
  error = e.message;
}

---

<BaseLayout>
  <div id="legacy-content-host">
    <template shadowrootmode="open">
      { content && <Fragment set:html={content} /> }
      { error && <h1>Error 500</h1><pre>{error}</pre> }
    </template>
  </div>
</BaseLayout>
