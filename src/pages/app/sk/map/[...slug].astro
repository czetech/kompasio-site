---
export const prerender = false;

import BaseLayout from "~/layouts/BaseLayout.astro";

const AUTH_USER = "kompas";
const AUTH_PASS = "kompas";

const fetchOptions = {
  headers: {
    Accept: "application/json",
    Authorization: `Basic ${Buffer.from(`${AUTH_USER}:${AUTH_PASS}`).toString("base64")}`,
  },
};

let content;
let error;

try {
  const response = await fetch(`https://kompas.cassiopea.sk${Astro.url.pathname}${Astro.url.search}`, fetchOptions);
  if (!response.ok) {
    throw new Error(`Failed to fetch: ${response.status} ${response.statusText}`);
  }
  content = (await response.json()).content;
} catch (e) {
  error = e.message;
}

---

<BaseLayout>
  <div id="legacy-content-host" class="w-full">
    <template shadowrootmode="open">
      { content && <Fragment set:html={content} /> }
      { error && <h1>Error 500</h1><pre>{error}</pre> }
    </template>
  </div>
</BaseLayout>

<script>
  function initializeDSD() {
    console.log("Astro debug: page-load");

    document.querySelectorAll('template[shadowrootmode]').forEach(template => {
      if (template.parentElement && !template.parentElement.shadowRoot) {
        const mode = template.getAttribute('shadowrootmode');
        const shadowRoot = template.parentElement.attachShadow({ mode });
        shadowRoot.appendChild(template.content.cloneNode(true));
        template.remove();
      }
    });

    const host = document.getElementById('legacy-content-host');
    if (host && host.shadowRoot) {
      const dsdGuestAppReadyEvent = new CustomEvent('guest-app:ready', {
        bubbles: true,
        composed: true,
        detail: {
          message: 'DSD Guest App content is ready.'
        }
      });
      host.dispatchEvent(dsdGuestAppReadyEvent);
      console.log('guest-app:ready event dispatched.'); // For debugging
    }
  }

  function deleteGuest() {
    console.log("Astro debug: before-swap");

    const host = document.getElementById('legacy-content-host');
    if (host && host.shadowRoot) {
      const dsdGuestAppDestroyEvent = new CustomEvent('guest-app:destroy', {
        bubbles: true,
        composed: true,
        detail: {
          message: 'DSD Guest App content should be destroyed.'
        }
      });
      host.dispatchEvent(dsdGuestAppDestroyEvent);
      console.log('guest-app:destroy event dispatched.'); // For debugging
    }
  }

  function guestSetHash(hash) {
    location.hash = hash;
  }

  document.addEventListener('astro:before-swap', deleteGuest);
  document.addEventListener('astro:page-load', initializeDSD);
</script>
