---
import { getEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Scrollable from "~/components/Scrollable.tsx";
import Markdown from "~/components/Markdown.astro";
import Section from "~/components/Section.astro";

const gdpr = await getEntry("gdpr", "gdpr");
---

<BaseLayout strictHeight>
  <Section heading={gdpr.data.title}>
    <Scrollable client:load class="px-6 pt-8 pb-16 md:px-8">
      <div class="text-sm">
        <Markdown content={gdpr.data.body} />
      </div>
    </Scrollable>
  </Section>
</BaseLayout>
