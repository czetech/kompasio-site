---
import { getEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import CircleArrow from "~/components/CircleArrow.tsx";
import Scrollable from "~/components/Scrollable.tsx";
import Markdown from "~/components/Markdown.astro";

const vop = await getEntry("vop", "vop");
---

<BaseLayout>
  <div class="flex gap-x-4 items-center p-8 justify-center">
    <CircleArrow direction="180" />
    <h1 class="font-semibold text-2xl md:text-3xl">{vop.data.title}</h1>
  </div>
  <Scrollable>
    <Markdown content={vop.data.body}>
  </Scrollable>
</BaseLayout>
