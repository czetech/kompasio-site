---
import { getEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Scrollable from "~/components/Scrollable.tsx";
import Markdown from "~/components/Markdown.astro";
import Section from "~/components/Section.astro";

const vop = await getEntry("vop", "vop");
---

<BaseLayout strictHeight>
  <Section heading={vop.data.title}>
    <Scrollable client:only class="px-6 pt-8 pb-16 md:px-8">
      <div class="text-sm">
        <Markdown content={vop.data.body} />
      </div>
    </Scrollable>
  </Section>
</BaseLayout>
