---
import { getCollection } from "astro:content";
import path from "pathe";

import BaseLayout from "~/layouts/BaseLayout.astro";
import StepUI from "~/components/StepUI.tsx";
import StepPagination from "~/components/StepPagination.tsx";
import StepStatus from "~/components/StepStatus.tsx";
import StepListToggle from "~/components/StepListToggle.tsx";
import StepListClear from "~/components/StepListClear.tsx";
import StepListItem from "~/components/StepListItem.tsx";
import Markdown from "~/components/Markdown.astro";
import BookOpen from "lucide-solid/icons/book-open";
import ListCheck from "lucide-solid/icons/list-check";
import ChevronRight from "lucide-solid/icons/chevron-right";
import Shrinkwrap from "~/components/Shrinkwrap.tsx";

const { journeySlug, stepIndex, journey } = Astro.props;
const step = journey.steps[stepIndex];

export const getStaticPaths = async () => {
return (await getCollection("guidesJourneys", ({ data }) => data.active)).flatMap((journey) =>
    journey.data.steps.map((_, index) => ({
      params: {
        journey: path.join(journey.id, index ? index.toString() : null),
      },
      props: {
        journeySlug: journey.id,
        stepIndex: index,
        journey: journey.data,
      },
    })),
  );
};

const category = (
  await getCollection(
    "guidesCategories",
    ({ data }) => data.uuid === journey.category,
  )
)[0];

const breadcrumbItems = [
  {
    name: "Návody",
    href: "/navody",
  },
  {
    name: category.data.title,
    href: `/navody/${category.id}`,
  },
];
---

<BaseLayout>
  <div class="w-full max-w-6xl p-4 md:p-8">
    <nav aria-label="Breadcrumb" class="mb-2">
      <ol class="flex gap-x-2 flex-wrap gap-y-1">
        {
          breadcrumbItems.map(({ name, href }) => (
            <li>
              <Shrinkwrap client:load class="items-center gap-x-2">
                <a href={href} class="text-vibrant-blue hover:underline">{name}</a>
                <ChevronRight class="w-5 h-5 flex-none" aria-hidden="true" slot="after" />
              </Shrinkwrap>
            </li>
          ))
        }
      </ol>
    </nav>
    <h1 class="mb-6 flex items-center gap-x-2 text-xl md:mb-8 md:text-2xl">
      {
        journey.type === "journey" ? (
          <ListCheck class="flex-none" />
        ) : (
          <BookOpen class="flex-none" />
        )
      }
      <span>{journey.title}</span>
    </h1>
    <div class="flex md:gap-x-8">
      <div class="min-w-0">
        <article class="mb-6 md:mb-8">
          <h2 class="mb-3 text-2xl font-semibold md:mb-4 md:text-3xl">
            {step.title}
          </h2>
          <Markdown content={step.body} />
        </article>
        {
          journey.type === "journey" && (
            <StepUI
              client:only
              journeyUuid={journey.uuid}
              stepUuid={step.uuid}
              stepTasks={step.tasks}
            />
          )
        }
        <StepPagination
          client:only
          journeySlug={journeySlug}
          journeyUuid={journey.uuid}
          stepUuid={step.uuid}
          previousStepIndex={stepIndex ? stepIndex - 1 : null}
          previousStepTitle={journey.steps[stepIndex - 1]?.title}
          nextStepIndex={stepIndex < journey.steps.length - 1
            ? stepIndex + 1
            : null}
          nextStepTitle={journey.steps[stepIndex + 1]?.title}
          type={journey.type}
            />
      </div>
      <aside>
        <StepListToggle client:load />
        <nav
          transition:persist
          id="step-list-content"
          class={`bg-shuttle-white-dark border-vibrant-blue invisible fixed
            right-6 bottom-24 h-[calc(100dvh_-_var(--spacing)_*_32)]
            md:max-h-[calc(100dvh_-_var(--spacing)_*_16)]
            w-[calc(100vw_-_var(--spacing)_*_12)] max-w-xs origin-bottom-right
            scale-90 rounded-2xl border-2 px-4 pb-8 pt-4 opacity-0 shadow-lg
            duration-250 peer-[.is-open]:visible peer-[.is-open]:scale-none
            peer-[.is-open]:opacity-100 md:visible md:sticky md:top-8 md:h-auto
            md:w-xs md:scale-none md:opacity-100 md:shadow-none overflow-y-auto`}
        >
          <h2 class="mb-4 text-lg md:mb-6">
            {journey.type === "journey" ? "Zoznam krokov" : "Obsah"}
          </h2>
          <ol
            start="0"
            class={`mb-6 flex list-decimal list-none flex-col gap-y-6 md:mb-8
              md:gap-y-8`}
          >
            {
              journey.steps.map((step, index) => (
                <li class="flex items-center gap-x-3">
                  {journey.type === "journey" && (
                    <StepStatus
                      client:only
                      journeyUuid={journey.uuid}
                      stepUuid={step.uuid}
                      stepTasks={step.tasks}
                      class="w-6 flex-none"
                    />
                  )}
                  <StepListItem
                    client:load
                    journeySlug={journeySlug}
                    pathname={Astro.url.pathname}
                    stepIndex={index}
                    title={step.title}
                    numbering={journey.type === "journey"}
                  />
                </li>
              ))
            }
          </ol>
          <StepListClear journeyUuid={journey.uuid} client:only />
        </nav>
      </aside>
    </div>
  </div>
</BaseLayout>
