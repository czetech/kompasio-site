---
export const prerender = false

import BaseLayout from "~/layouts/BaseLayout.astro";
import * as cheerio from "cheerio";

const LEGACY_PHP_APP_URL = "https://kompas.cassiopea.sk";
const AUTH_USER = "kompas";
const AUTH_PASS = "kompas";

const slug = Astro.params.slug || "";
const targetUrl = `${LEGACY_PHP_APP_URL}/zoznam/${slug}${Astro.url.search}`;

const authHeader = `Basic ${Buffer.from(`${AUTH_USER}:${AUTH_PASS}`).toString("base64")}`;

const fetchOptions = {
  headers: {
    'Authorization': authHeader
  }
};

const response = await fetch(targetUrl, fetchOptions);

if (!response.ok) {
  throw new Error(`Failed to fetch: ${response.status} ${response.statusText}`);
}

const rawPhpHtml = await response.text();

const $ = cheerio.load(rawPhpHtml);

$("meta, title, noscript").remove();
$('script[data-cookiecategory="analytics"]').remove();
$('#main header, #main footer').remove();
$("#cc--main").remove();

$("#main").css("top", "auto");
$("#main").css("position", "relative");
$('#wrapper').css('padding-top', '0');

let scriptsToLoad: { src?: string; content?: string }[] = [];
let scripts = [];

$('script').each((i, el) => {
  const src = $(el).attr('src');
  const content = $(el).html();
  if (src) {
    scriptsToLoad.push({ src });
  } else if (content) {
    scriptsToLoad.push({ content });
  }
  scripts.push(el);
  });

$('script').remove();

const headContents = $("head").html() || "";
const bodyContents = $("body").html() || "";

---
<BaseLayout>
  <div id="legacy-content-host">
  <template shadowrootmode="open">
    <Fragment set:html={headContents} />
    <div id="body">
      <Fragment set:html={bodyContents} />
    </div>
  </template>
  </div>
</BaseLayout>

<script define:vars={{ scripts: scriptsToLoad }}>
  document.getElementById("cc--main").remove();

  // DSD Polyfill to ensure it works on all browsers
  if (!HTMLTemplateElement.prototype.hasOwnProperty("shadowRootMode")) {
    (function polyfillDSD(root) {
      root.querySelectorAll("template[shadowrootmode]").forEach(template => {
        const mode = template.getAttribute("shadowrootmode");
        const shadowRoot = template.parentElement.attachShadow({ mode });
        shadowRoot.appendChild(template.content);
        template.remove();
        polyfillDSD(shadowRoot);
      });
    })(document);
  }

  const host = document.getElementById('legacy-content-host');
  const shadowRoot = host?.shadowRoot;

  if (shadowRoot) {
    // This function prepares the environment and then loads the scripts.
    prepareAndLoadLegacyScripts(shadowRoot, scripts);
  }

  function prepareAndLoadLegacyScripts(shadowRoot, scriptsToLoad) {
    // --- MONKEY-PATCHING SECTION ---
    // Here we trick the legacy scripts into thinking the shadowRoot is the main document.

    // 1. Redirect standard DOM queries to the Shadow DOM
    const originalGetElementById = document.getElementById;
    document.getElementById = (id) => shadowRoot.getElementById(id) || originalGetElementById.call(document, id);

    const originalQuerySelector = document.querySelector;
    document.querySelector = (selector) => shadowRoot.querySelector(selector) || originalQuerySelector.call(document, selector);

    const originalQuerySelectorAll = document.querySelectorAll;
    document.querySelectorAll = (selector) => {
      const shadowResults = shadowRoot.querySelectorAll(selector);
      return shadowResults.length ? shadowResults : originalQuerySelectorAll.call(document, selector);
    };

    // 2. Make the `document.body` property point to our shadowed body
    Object.defineProperty(document, 'body', {
      get: () => shadowRoot.querySelector('#body') || document.body,
      configurable: true,
    });

    // --- SCRIPT LOADER SECTION ---
    // Now we load the scripts into the prepared environment.
    scriptsToLoad.forEach(scriptInfo => {
      const script = document.createElement('script');
      if (scriptInfo.src) {
        script.src = scriptInfo.src;
        script.async = false; // Important for scripts that depend on each other (like jQuery plugins)
      } else {
        script.textContent = scriptInfo.content;
      }
      // Append the script to the SHADOW ROOT, which will trigger execution.
      shadowRoot.appendChild(script);
    });
  }
</script>
