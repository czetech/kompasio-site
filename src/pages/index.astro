---
import { getEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Card from "~/components/Card.astro";

const landing = await getEntry("landing", "landing");
---
<BaseLayout>
  <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3 m-8">
    {
      landing.data.cards.map((card) => (
      <Card title={card.title} color={card.color} href={card.url} description={card.description} />
      ))
    }
  </div>
</BaseLayout>
