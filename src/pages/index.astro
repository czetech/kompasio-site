---
import { getEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Card from "~/components/Card.astro";
import ContentImage from "~/components/ContentImage.astro";


const landing = await getEntry("landing", "landing");

---
<BaseLayout>
  <div class="lg:relative w-full max-w-212 mx-auto flex flex-col gap-y-4">
    <div class="flex justify-end w-full">
      <ContentImage path={landing.data.heroImage} />
    </div>
    <div class="lg:absolute lg:top-0 flex lg:flex-col justify-center h-full lg:w-96 w-full lg:flex-none">
      <h1 class="text-5xl text-vibrant-blue font-semibold">{landing.data.heroTitle}</h1>
    </div>
  </div>
  <div class="p-8 w-full">
  <div class="masonry relative">
    {
      landing.data.cards.map((card) => (
      <div class="absolute">
        <Card title={card.title} color={card.color} href={card.url} image={card.image} description={card.description} />
      </div>
      ))
    }
  </div>
  </div>
</BaseLayout>

<script>
  import MiniMasonry from "minimasonry";

  const masonry = new MiniMasonry({
    container: '.masonry',
    gutter: 32,
    surroundingGutter: false,
    ultimateGutter: 0,
  });

  document.addEventListener("astro:page-load", () => {
    masonry.layout();
    console.log(masonry);
  });
</script>
